{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccc://game-theory/strategic-analysis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis_id", "players", "objectives", "constraints", "information_by_player", "information_asymmetry", "strategies", "costs", "payoffs", "likely_response", "second_order_response", "repeated_game_effects", "reputation_cooperation_effects", "hard_controls", "no_play_option", "evidence_change_trigger", "recommendation", "will_this_work", "what_happens_after_we_act", "authority", "confidence", "can_execute", "can_write_verified_ledger_truth"],
  "properties": {
    "analysis_id": {"type": "string"},
    "players": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "objectives": {"type": "object", "minProperties": 1},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "information_by_player": {"type": "object", "minProperties": 1},
    "information_asymmetry": {"type": "array", "items": {"type": "string"}},
    "strategies": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "costs": {"type": "object"},
    "payoffs": {"type": "object"},
    "likely_response": {"type": "string", "minLength": 1},
    "second_order_response": {"type": "string", "minLength": 1},
    "repeated_game_effects": {"type": "string", "minLength": 1},
    "reputation_cooperation_effects": {"type": "string", "minLength": 1},
    "hard_controls": {"type": "array", "items": {"type": "string"}},
    "no_play_option": {"type": "string", "minLength": 1},
    "evidence_change_trigger": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "recommendation": {"enum": ["ACT", "HOLD", "DEFER", "NO_PLAY", "SEEK_EVIDENCE", "COUNTERMOVE", "RETURN_TO_BETA"]},
    "will_this_work": {"type": "string"},
    "what_happens_after_we_act": {"type": "string"},
    "authority": {"const": "ADVISORY_ONLY"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "can_execute": {"const": false},
    "can_write_verified_ledger_truth": {"const": false},
    "reason": {"type": "string"},
    "hard_control_precedence": {"type": "array", "items": {"type": "string"}},
    "executed": {"type": "boolean"}
  }
}

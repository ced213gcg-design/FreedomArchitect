{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccc.local/schemas/living-lab-operation.schema.json",
  "title": "CCC Living Lab Operation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "objective",
    "worker",
    "dimension",
    "fact",
    "risk",
    "action",
    "evidence",
    "result",
    "root_cause",
    "recovery",
    "skills_demonstrated",
    "mentor_grade",
    "training_output",
    "portfolio_output",
    "automation_candidate",
    "reinjection_target",
    "next_owner",
    "exact_next_action",
    "expected_next_evidence"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "worker": {"enum": ["COMMAND", "INTELLIGENCE", "SECURITY", "REVENUE", "COMMS"]},
    "dimension": {"type": "string", "minLength": 1},
    "fact": {"type": "string"},
    "risk": {"type": "string"},
    "action": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "result": {"enum": ["PASS", "PARTIAL", "HOLD", "FAIL", "UNKNOWN"]},
    "root_cause": {"type": ["string", "null"]},
    "recovery": {"type": ["string", "null"]},
    "skills_demonstrated": {"type": "array", "items": {"type": "string"}},
    "mentor_grade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical_execution", "evidence_quality", "analysis", "security_judgment", "recovery", "communication"],
      "properties": {
        "technical_execution": {"type": "integer", "minimum": 0, "maximum": 5},
        "evidence_quality": {"type": "integer", "minimum": 0, "maximum": 5},
        "analysis": {"type": "integer", "minimum": 0, "maximum": 5},
        "security_judgment": {"type": "integer", "minimum": 0, "maximum": 5},
        "recovery": {"type": "integer", "minimum": 0, "maximum": 5},
        "communication": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "training_output": {"type": ["string", "null"]},
    "portfolio_output": {"type": ["string", "null"]},
    "automation_candidate": {"type": ["string", "null"]},
    "reinjection_target": {"type": ["string", "null"]},
    "next_owner": {"type": "string", "minLength": 1},
    "exact_next_action": {"type": "string", "minLength": 1},
    "expected_next_evidence": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"},
    "timestamp": {"type": "string"},
    "superstate": {"enum": ["PASS", "PARTIAL", "HOLD", "FAIL", "UNKNOWN"]}
  }
}

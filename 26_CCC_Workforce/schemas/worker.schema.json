{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccc.workforce.worker.v1",
  "type": "object",
  "required": ["id", "codename", "executive_analogue", "primary_organs", "state", "identity_ref", "shift"],
  "properties": {
    "id": {"type": "string", "enum": ["command", "intelligence", "security", "revenue", "communications"]},
    "codename": {"type": "string", "enum": ["COMMAND", "INTELLIGENCE", "SECURITY", "REVENUE", "COMMS"]},
    "executive_analogue": {"type": "string", "minLength": 1},
    "primary_organs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "state": {"type": "string", "enum": ["OFFLINE", "DORMANT", "SEED", "INCUBATE", "ACTIVE", "VERIFY", "READY", "THRIVE", "HOLD", "ISOLATE"]},
    "identity_ref": {"type": "string", "pattern": "^identity-ref:ccc-worker-"},
    "shift": {
      "type": "object",
      "required": ["timezone", "start", "mid_report", "end", "weekly_responsibility_hours"],
      "properties": {
        "timezone": {"const": "America/Chicago"},
        "start": {"type": "string"},
        "mid_report": {"type": "string"},
        "end": {"type": "string"},
        "weekly_responsibility_hours": {"type": "integer", "minimum": 50}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
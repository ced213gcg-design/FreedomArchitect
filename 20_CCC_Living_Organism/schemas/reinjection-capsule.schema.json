{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccc://schemas/reinjection-capsule.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["capsule_id", "event_class", "objective", "starting_state", "final_evidence", "measurements", "safety_result", "replication_recipe", "dependencies", "productive_value", "evidence_sextet", "terminal_value", "reinjection_destination", "next_alpha"],
  "properties": {
    "capsule_id": {"type": "string", "minLength": 1},
    "event_class": {"enum": ["FAULT", "FAILURE", "DELAY", "RISK", "NEGATIVE_SIGNAL", "VICTORY", "MILESTONE", "ACCOLADE", "OMEGA"]},
    "objective": {"type": "string"},
    "starting_state": {"type": "string"},
    "failures_refinements": {"type": "array", "items": {"type": "string"}},
    "final_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "measurements": {"type": "object"},
    "safety_result": {"type": "string"},
    "replication_recipe": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "productive_value": {"type": ["string", "number"]},
    "evidence_sextet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SOURCE", "TIME", "OWNER", "CHANGE", "VALIDATION", "PROVENANCE"],
      "properties": {
        "SOURCE": {"type": "string"}, "TIME": {"type": "string"}, "OWNER": {"type": "string"},
        "CHANGE": {"type": "string"}, "VALIDATION": {"type": "string"}, "PROVENANCE": {"type": "string"}
      }
    },
    "terminal_value": {"enum": ["EVIDENCE", "CAPABILITY", "MEMORY", "SEED", "DOCUMENTED_REJECTION"]},
    "reinjection_destination": {"type": "string", "minLength": 1},
    "next_alpha": {"type": "string", "minLength": 1}
  }
}

# CCC v10.1 example environment. Never place real secrets in source.
CCC_ENV=development
CCC_HOST_ID=ccc-hp-dev-01
CCC_DASHBOARD_HOST=127.0.0.1
CCC_DASHBOARD_PORT=8787
CCC_LEDGER_PATH=./runtime/ccc-ledger.jsonl
CCC_EXCEPTION_PATH=./runtime/ccc-exceptions.jsonl
CCC_EXCEPTION_POLICY=./config/exception-policy.yaml
CCC_SOC_STATE_PATH=
CCC_SLACK_ENABLED=false
# Configure Gmail/Slack credentials only through approved connector/environment secret storage.
# Never commit tokens, passwords, webhook URLs, OAuth secrets or customer/application private data.
